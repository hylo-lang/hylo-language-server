From 370956fb976f16bd13c33d7c1053c1462f5b8a06 Mon Sep 17 00:00:00 2001
From: Ambrus Toth <ping@ambrus.dev>
Date: Sun, 25 Oct 2026 22:43:17 +0100
Subject: [PATCH 1/2] Trim header whitespace without Foundation-only API

`MessageFraming.readHeader` trimmed header names and values with
`trimmingCharacters(in: .whitespaces)`. With swift-foundation, both that
method and `CharacterSet.whitespaces` live in the full Foundation module,
not in FoundationEssentials. A WebAssembly (wasm32-unknown-wasip1) build
that links only FoundationEssentials, to avoid the size of Foundation and
its ICU data, therefore fails with:

    wasm-ld: error: messageframing.o: undefined symbol:
      (extension in Foundation):Swift.StringProtocol.trimmingCharacters(in:)
    wasm-ld: error: messageframing.o: undefined symbol:
      static Foundation.CharacterSet.whitespaces.getter

Trim with the standard library instead, removing leading and trailing
tabs and Unicode space separators (general category Zs), plus U+200B
ZERO WIDTH SPACE, which `CharacterSet.whitespaces` also contains.

There is no change in behavior on any platform: on Linux, the new
function returns the same result as `trimmingCharacters(in: .whitespaces)`
for every Unicode scalar placed before, after, around and alone in a
string. No conditional compilation is needed.
---
 .../Framing/MessageFraming.swift              | 22 +++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/Sources/LanguageServerProtocol/Framing/MessageFraming.swift b/Sources/LanguageServerProtocol/Framing/MessageFraming.swift
index 7bcd1c9..3cee76c 100644
--- a/Sources/LanguageServerProtocol/Framing/MessageFraming.swift
+++ b/Sources/LanguageServerProtocol/Framing/MessageFraming.swift
@@ -18,9 +18,27 @@ struct MessageFraming {
 
 	public static func readHeader(_ value: String) throws -> (String, String) {
 		let components = value.components(separatedBy: ":")
-		let name = components[0].trimmingCharacters(in: .whitespaces)
-		let value = components[1].trimmingCharacters(in: .whitespaces)
+		let name = components[0].trimmingWhitespace()
+		let value = components[1].trimmingWhitespace()
 
 		return (name, value)
 	}
 }
+
+extension String {
+	/// Returns `self` without leading and trailing tabs and space separators.
+	///
+	/// This is equivalent to `trimmingCharacters(in: .whitespaces)`, which is only available with
+	/// the full Foundation, not with FoundationEssentials. Like `CharacterSet.whitespaces`, it
+	/// treats U+200B ZERO WIDTH SPACE as whitespace.
+	fileprivate func trimmingWhitespace() -> String {
+		let isWhitespace = { (u: Unicode.Scalar) in
+			u == "\t" || u == "\u{200B}" || u.properties.generalCategory == .spaceSeparator
+		}
+
+		guard let start = unicodeScalars.firstIndex(where: { !isWhitespace($0) }) else { return "" }
+		let end = unicodeScalars.lastIndex(where: { !isWhitespace($0) })!
+
+		return String(unicodeScalars[start...end])
+	}
+}
