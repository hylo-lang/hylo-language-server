
extension Bool {
  static fun the_bool() -> Bool { .new() }
}
extension Int {
  static fun the_int() -> Int { .new() }
}

fun a(x: Int, y: Int) {}
fun a(x: Bool, y: Bool) {}

extension <T> T {
  // Use as: ?Bool
  static subscript prefix? () -> Self {
    Builtin.trap()
  }

  // Use as: Bool.todo()
  static subscript todo() -> Self {
    Builtin.trap()
  }
}

// Use as: todo[Bool]
subscript todo<T>(t: Metatype<T>) -> T {
  Builtin.trap()
}

fun f<T is Movable>(x: T, y: Int) -> T {
  x
}
fun f(x: Bool, y: Bool) -> Bool {
  x
}
extension Movable {
  static fun mov() {
  }
}

fun main() {
  // a(., todo[Bool]) // [ .the_bool() ]

  // let r = a(?Bool, .new())
  let x = f(todo[T], .)
}