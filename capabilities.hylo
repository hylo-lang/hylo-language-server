struct A {
  memberwise init
  static fun foo() -> A { .new() }
}

struct B {
  memberwise init
  static fun bar() -> B { .new() } 
  static fun car() -> B { .new() }
}


fun a(x: B, y: B) {}
fun a(x: A, y: A) {}

extension Int {
  fun infix+++(y: Int) -> Int { self + y }
}

